---
import { COR, ELEMENTO, mioloIcone } from '../rotulos.ts';
import type { Elemento } from '../types.ts';

const { e } = Astro.props as { e: Elemento };
---

<span class:list={['inline-flex items-center gap-1 rounded-full py-0.5 pr-2.5 pl-1.5 text-xs font-semibold', COR[e]]}>
  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={mioloIcone(e)} />{ELEMENTO[e]}
</span>
