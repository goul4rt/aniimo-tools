---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { porSlug } from '../data.ts';
import { PAGINAS, ogDe } from '../paginas.ts';
import { UMAMI_ID } from '../metricas.ts';
import { ChevronDown, Menu } from 'lucide-static';
import { blog, codigos, grupos, miolo, principais } from '../nav.ts';
import { temPostRecente } from '../blog.ts';

interface Props {
  title: string;
  description?: string;
  /** Página de erro (404): fica fora do registro, sem canonical e com noindex; usa a imagem OG da home. */
  erro?: boolean;
}
const { title, description = 'Ferramentas de Aniimo em português, com dados abertos.', erro = false } = Astro.props;
// Canonical sempre no domínio próprio: o mesmo conteúdo também responde em aniimo-tools.pages.dev.
const rota = erro ? '/' : Astro.url.pathname;
const canonical = new URL(rota, Astro.site);
// Toda página precisa estar em src/paginas.ts (imagem OG + sitemap). Esquecer quebra a build aqui.
const slug = rota.match(/^\/aniilog\/([^/]+)\/$/)?.[1];
const aniimo = slug ? porSlug.get(slug) : undefined;
const posts = await getCollection('blog');
const slugPost = rota.match(/^\/blog\/([^/]+)\/$/)?.[1];
const post = slugPost ? posts.find((p) => p.id === slugPost) : undefined;
if (!PAGINAS[rota] && !aniimo && !post) throw new Error(`Página ${rota} fora de src/paginas.ts: registre para ter imagem OG e entrar no sitemap.`);
const og = new URL(ogDe(rota), Astro.site);
const ogAlt = aniimo ? `${aniimo.nome.pt}: stats base e elementos, no Aniilog do Aniimo Tools`
  : post ? `${post.data.titulo}, no Blog do Aniimo Tools`
  : `${PAGINAS[rota].titulo}: ${PAGINAS[rota].sub}`;
// Dados estruturados: WebSite na home; nas outras, a trilha Início › Página (› Aniimo/Post).
const migalhas = [['/', 'Início'], ...(rota === '/' ? [] : aniimo ? [['/aniilog/', 'Aniilog'], [rota, aniimo.nome.pt]] : post ? [['/blog/', 'Blog'], [rota, post.data.titulo]] : [[rota, PAGINAS[rota].nome]])];
const jsonLd = rota === '/'
  ? { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Aniimo Tools', url: Astro.site!.href, inLanguage: 'pt-BR', description }
  : {
      '@context': 'https://schema.org', '@type': 'BreadcrumbList',
      itemListElement: migalhas.map(([u, nome], i) => ({ '@type': 'ListItem', position: i + 1, name: nome, item: new URL(u, Astro.site).href })),
    };
// Menu: os principais à vista; o resto num painel "Ferramentas" em grupos (listas em src/nav.ts). No celular só aparece o ☰.
const naRota = (href: string) => rota.startsWith(href);
const noPainel = grupos.some(([, itens]) => itens.some(([h]) => h !== '/time/' && naRota(h)));
const blogRecente = temPostRecente(posts);
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {erro ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content={aniimo || post ? 'article' : 'website'} />
    <meta property="og:site_name" content="Aniimo Tools" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replaceAll('<', '\\u003c')} />
    <meta name="theme-color" content="#286464" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600&family=JetBrains+Mono:wght@400;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    {/* Umami: só conta no domínio próprio; ignora ?t=/?c= e #âncoras (senão cada time vira uma "página"); coleta Web Vitals; respeita Do Not Track. */}
    {UMAMI_ID && (
      <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id={UMAMI_ID} data-domains="aniimo.ogoulart.dev"
        data-exclude-search="true" data-exclude-hash="true" data-performance="true" data-do-not-track="true"></script>
    )}
  </head>
  <body class="flex min-h-screen flex-col antialiased">
    <header class="bg-casal">
      <nav class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 py-3 sm:px-6">
        <a href="/" data-umami-event="nav" data-umami-event-destino="inicio" class="flex items-center gap-2.5 text-white hover:text-white">
          <img src="/logo.png" alt="" width="36" height="36" />
          <span class="font-display text-xl font-semibold">Aniimo Tools</span>
        </a>
        <div class="flex items-center gap-0.5 text-sm font-semibold whitespace-nowrap">
          {principais.map(([href, label]) => (
            <a href={href} aria-current={naRota(href) ? 'page' : undefined} data-umami-event="nav" data-umami-event-destino={label}
              class:list={['hidden rounded-full px-3.5 py-2 hover:bg-zumthor/15 hover:text-white md:inline', naRota(href) ? 'bg-zumthor/15 text-white' : 'text-zumthor/85']}>{label}</a>
          ))}
          <details id="menu" class="group relative">
            <summary data-umami-event="nav_menu" class:list={['flex cursor-pointer list-none items-center gap-1.5 rounded-full px-3.5 py-2 hover:bg-zumthor/15 hover:text-white group-open:bg-zumthor/15 group-open:text-white [&::-webkit-details-marker]:hidden', noPainel ? 'bg-zumthor/15 text-white' : 'text-zumthor/85']}>
              <svg class="h-5 w-5 md:hidden" viewBox="0 0 24 24" set:html={miolo(Menu)} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" />
              <span class="hidden md:inline">Ferramentas</span><span class="md:hidden">Menu</span>
              <svg class="hidden h-4 w-4 transition-transform group-open:rotate-180 md:block" viewBox="0 0 24 24" set:html={miolo(ChevronDown)} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" />
            </summary>
            <div class="fixed inset-x-3 top-16 z-50 max-h-[calc(100vh-5rem)] overflow-y-auto rounded-[20px] border border-line bg-white p-2 whitespace-normal text-ink shadow-[0_12px_32px_-8px_rgb(21_57_58/.3)] md:absolute md:inset-x-auto md:top-full md:right-0 md:mt-2 md:w-[740px]">
              <div class="grid gap-1 md:grid-cols-3">
                {[['Principais', [...principais.slice(0, 2), blog, codigos]] as (typeof grupos)[number], ...grupos].map(([grupo, itens], g) => (
                  <div class:list={[g === 0 && 'md:hidden']}>
                    <p class="px-3 pt-2 pb-1 text-[11px] font-bold tracking-wider text-danube uppercase">{grupo}</p>
                    {itens.map(([href, label, desc, ic]) => (
                      <a href={href} aria-current={naRota(href) ? 'page' : undefined} data-umami-event="nav" data-umami-event-destino={label}
                        class="flex items-start gap-3 rounded-xl px-3 py-2 text-ink hover:bg-danube-50 hover:text-ink aria-[current=page]:bg-casal-50">
                        <span class="grid h-8 w-8 shrink-0 place-items-center rounded-[10px] bg-casal-50 text-casal">
                          <svg class="h-4 w-4" viewBox="0 0 24 24" set:html={miolo(ic)} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" />
                        </span>
                        <span class="leading-tight"><span class="block text-sm font-semibold">{label}</span><span class="block text-xs font-normal text-muted">{desc}</span></span>
                      </a>
                    ))}
                  </div>
                ))}
              </div>
            </div>
          </details>
          <a href="/blog/" aria-current={naRota('/blog/') ? 'page' : undefined} data-umami-event="nav" data-umami-event-destino="Blog"
            class:list={['hidden items-center gap-1.5 rounded-full px-3.5 py-2 hover:bg-zumthor/15 hover:text-white md:inline-flex', naRota('/blog/') ? 'bg-zumthor/15 text-white' : 'text-zumthor/85']}>
            Blog{blogRecente && <span class="h-[7px] w-[7px] rounded-full bg-[#F48DB8]" aria-hidden="true" />}
          </a>
          <a href="/codigos/" aria-current={naRota('/codigos/') ? 'page' : undefined} data-umami-event="nav" data-umami-event-destino="Códigos"
            class:list={['hidden rounded-full px-3.5 py-2 hover:bg-zumthor/15 hover:text-white md:inline', naRota('/codigos/') ? 'bg-zumthor/15 text-white' : 'text-zumthor/85']}>Códigos</a>
        </div>
      </nav>
    </header>
    <main class="mx-auto w-full max-w-6xl flex-1 px-4 pt-8 pb-18 sm:px-6">
      <slot />
    </main>
    <footer class="border-t border-danube-100">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-2 gap-y-2 px-4 py-5 text-sm text-muted sm:px-6">
        <span>Fan-site não-oficial. Aniimo e todos os assets são © Pawprint Studio. Sem afiliação.</span>
        <a href="/creditos/" data-umami-event="rodape_creditos" class="text-casal underline">Créditos e dados</a>
        <a href="/api/" data-umami-event="rodape_api" class="text-casal underline">API</a>
        <a href="https://ko-fi.com/ogoul4rt" target="_blank" rel="noopener" data-umami-event="kofi"
          class="inline-flex items-center gap-1.5 rounded-full bg-[#F48DB8]/20 px-3 py-1 font-semibold text-casal no-underline hover:bg-[#F48DB8]/35 hover:text-casal sm:ml-auto">
          <svg class="h-4 w-4 text-[#C94B7F]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 14c1.5-1.5 3-3.2 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.8 0-3 .5-4.5 2-1.5-1.5-2.7-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4 3 5.5l7 7Z"/></svg>
          Curtiu? Apoie no Ko-fi
        </a>
      </div>
    </footer>
    <script>
      // Painel do menu: fecha ao clicar fora ou apertar Esc (o <details> sozinho só fecha clicando no botão).
      const menu = document.getElementById('menu') as HTMLDetailsElement;
      document.addEventListener('click', (ev) => { if (menu.open && !menu.contains(ev.target as Node)) menu.open = false; });
      document.addEventListener('keydown', (ev) => { if (ev.key === 'Escape' && menu.open) { menu.open = false; menu.querySelector('summary')!.focus(); } });
      // Qualquer link para fora do site (wiki, fontes, GitHub…) vira "link_externo" com o destino, sem marcar um por um.
      document.addEventListener('click', (ev) => {
        const a = (ev.target as HTMLElement).closest?.<HTMLAnchorElement>('a[href^="http"]');
        if (!a || a.host === location.host || a.hasAttribute('data-umami-event')) return;
        (window as unknown as { umami?: { track: (n: string, d: object) => void } }).umami?.track('link_externo', { destino: a.host, pagina: location.pathname });
      });
    </script>
  </body>
</html>
