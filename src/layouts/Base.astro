---
import '../styles/global.css';
import { porSlug } from '../data.ts';
import { PAGINAS, ogDe } from '../paginas.ts';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Ferramentas de Aniimo em português, com dados abertos.' } = Astro.props;
// Canonical sempre no domínio próprio: o mesmo conteúdo também responde em aniimo-tools.pages.dev.
const rota = Astro.url.pathname;
const canonical = new URL(rota, Astro.site);
// Toda página precisa estar em src/paginas.ts (imagem OG + sitemap). Esquecer quebra a build aqui.
const slug = rota.match(/^\/aniilog\/([^/]+)\/$/)?.[1];
const aniimo = slug ? porSlug.get(slug) : undefined;
if (!PAGINAS[rota] && !aniimo) throw new Error(`Página ${rota} fora de src/paginas.ts: registre para ter imagem OG e entrar no sitemap.`);
const og = new URL(ogDe(rota), Astro.site);
const ogAlt = aniimo ? `${aniimo.nome.pt}: stats base e elementos, no Aniilog do Aniimo Tools` : `${PAGINAS[rota].titulo}: ${PAGINAS[rota].sub}`;
// Dados estruturados: WebSite na home; nas outras, a trilha Início › Página (› Aniimo).
const migalhas = [['/', 'Início'], ...(rota === '/' ? [] : aniimo ? [['/aniilog/', 'Aniilog'], [rota, aniimo.nome.pt]] : [[rota, PAGINAS[rota].nome]])];
const jsonLd = rota === '/'
  ? { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Aniimo Tools', url: Astro.site!.href, inLanguage: 'pt-BR', description }
  : {
      '@context': 'https://schema.org', '@type': 'BreadcrumbList',
      itemListElement: migalhas.map(([u, nome], i) => ({ '@type': 'ListItem', position: i + 1, name: nome, item: new URL(u, Astro.site).href })),
    };
const nav = [
  ['/aniilog/', 'Aniilog'],
  ['/tipos/', 'Tipos'],
  ['/codigos/', 'Códigos'],
  ['/colecao/', 'Coleção'],
  ['/time/', 'Time'],
  ['/comparar/', 'Comparar'],
  ['/tier/', 'Tier list'],
  ['/evolucao/', 'Resonance'],
  ['/api/', 'API'],
];
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content={aniimo ? 'article' : 'website'} />
    <meta property="og:site_name" content="Aniimo Tools" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replaceAll('<', '\\u003c')} />
    <meta name="theme-color" content="#286464" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600&family=JetBrains+Mono:wght@400;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="flex min-h-screen flex-col antialiased">
    <header class="bg-casal">
      <nav class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 py-3 sm:px-6">
        <a href="/" class="flex items-center gap-2.5 text-white hover:text-white">
          <img src="/favicon.svg" alt="" width="32" height="32" />
          <span class="font-display text-xl font-semibold">Aniimo Tools</span>
        </a>
        <div class="-mx-4 flex gap-0.5 overflow-x-auto px-4 text-sm font-semibold whitespace-nowrap sm:mx-0 sm:px-0">
          {nav.map(([href, label]) => {
            const atual = Astro.url.pathname.startsWith(href);
            return (
              <a href={href} aria-current={atual ? 'page' : undefined}
                class:list={['rounded-full px-3.5 py-2 hover:bg-zumthor/15 hover:text-white', atual ? 'bg-zumthor/15 text-white' : 'text-zumthor/85']}>{label}</a>
            );
          })}
        </div>
      </nav>
    </header>
    <main class="mx-auto w-full max-w-6xl flex-1 px-4 pt-8 pb-18 sm:px-6">
      <slot />
    </main>
    <footer class="border-t border-danube-100">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-2 gap-y-2 px-4 py-5 text-sm text-muted sm:px-6">
        <span>Fan-site não-oficial. Aniimo e todos os assets são © Pawprint Studio. Sem afiliação.</span>
        <a href="/creditos/" class="text-casal underline">Créditos e dados</a>
        <a href="https://ko-fi.com/ogoul4rt" target="_blank" rel="noopener"
          class="inline-flex items-center gap-1.5 rounded-full bg-[#F48DB8]/20 px-3 py-1 font-semibold text-casal no-underline hover:bg-[#F48DB8]/35 hover:text-casal sm:ml-auto">
          <svg class="h-4 w-4 text-[#C94B7F]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 14c1.5-1.5 3-3.2 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.8 0-3 .5-4.5 2-1.5-1.5-2.7-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4 3 5.5l7 7Z"/></svg>
          Curtiu? Apoie no Ko-fi
        </a>
      </div>
    </footer>
  </body>
</html>
