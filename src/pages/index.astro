---
import Base from '../layouts/Base.astro';
import { aniimos } from '../data.ts';
import codigos from '../../data/codigos.json';

const formas = aniimos.reduce((n, a) => n + a.formas.length, 0);
const ativos = codigos.codigos.filter((c) => c.ativo).length;
const cards = [
  ['/aniilog/', 'Aniilog', `${aniimos.length} Aniimo e ${formas} formas: stats, skills, traços e onde encontrar.`],
  ['/tipos/', 'Tabela de tipos', 'Escolha o elemento do inimigo e veja quem ataca bem e quem resiste.'],
  ['/codigos/', 'Códigos de resgate', `${ativos} códigos ativos, com botão de copiar.`],
  ['/colecao/', 'Minha coleção', 'Marque as formas que você já tem, incluindo Prismana. Exporta e importa.'],
  ['/time/', 'Montador de time', 'Cobertura de elementos, fraquezas em comum e funções do seu time de 4.'],
  ['/comparar/', 'Comparar stats', 'Até 3 Aniimo ou formas lado a lado.'],
  ['/tier/', 'Tier list', 'Monte sua tier list de SSS a D, com nomes de tier editáveis e filtro de Prismana.'],
  ['/homeland/', 'Otimizador de Homeland', 'O que cada instalação deve produzir para render mais Home Coin, a equipe de Aniimo e o layout de clima.'],
  ['/evolucao/', 'Planejador de Resonance', 'Quanto Dewdrop, pedras e Cristal de Onifonte até o estágio que você quer.'],
  ['/api/', 'API pública', 'Todos os dados em JSON aberto, para bots e outros sites.'],
];
---

<Base title="Aniimo Tools · ferramentas de Aniimo em português" description={`Aniilog com ${aniimos.length} Aniimo, tabela de tipos, montador de time, tier list e códigos de resgate. Tudo em português, com dados da wiki oficial.`}>
  <header class="relative overflow-hidden rounded-[28px] bg-casal px-6 py-12 text-white sm:px-10 sm:py-16">
    <!-- ponytail: sem arte do jogo no hero; o site não hospeda assets (ver /creditos). -->
    <div class="bg-twining pointer-events-none absolute -top-24 -right-16 h-72 w-72 rounded-full opacity-60 blur-3xl"></div>
    <div class="bg-twining pointer-events-none absolute -bottom-32 left-1/3 h-64 w-64 rounded-full opacity-30 blur-3xl"></div>
    <div class="relative max-w-2xl">
      <span class="rounded-full bg-casal-900/60 px-3 py-1 font-mono text-xs tracking-widest text-zumthor uppercase">{aniimos.length} Aniimo · {ativos} códigos ativos</span>
      <h1 class="mt-4 text-5xl text-white sm:text-6xl">Aniimo Tools</h1>
      <p class="mt-3 text-lg text-zumthor">
        Ferramentas de Aniimo em português, com os nomes oficiais do jogo e dados atualizados todo dia a partir da wiki oficial.
      </p>
    </div>
  </header>
  <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {cards.map(([href, titulo, texto]) => (
      <a href={href} data-umami-event="home_card" data-umami-event-ferramenta={titulo} class="card flex flex-col gap-2 p-6">
        <span class="flex items-center justify-between gap-2">
          <h2 class="text-xl font-semibold">{titulo}</h2>
          <span class="text-lg text-danube" aria-hidden="true">→</span>
        </span>
        <p class="text-[15px] leading-relaxed text-muted">{texto}</p>
      </a>
    ))}
  </div>
</Base>
