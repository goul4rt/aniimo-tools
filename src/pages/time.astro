---
import Base from '../layouts/Base.astro';
import { aniimos } from '../data.ts';
import tabela from '../../data/elementos.json';
import { ELEMENTO, PAPEL } from '../rotulos.ts';
import { icone } from '../scripts/icones.ts';

// Só o que o montador usa, embutido na página: o cálculo roda no navegador.
const dados = {
  aniimos: aniimos.map((a) => ({
    slug: a.slug, id: a.id, nome: a.nome.pt, en: a.nome.en,
    formas: a.formas.map((f) => ({ chave: f.chave, nome: f.nome.pt, elementos: f.elementos, papeis: f.papeis, imagem: f.imagem, total: f.stats.total })),
  })),
  ataque: tabela.ataque, ELEMENTO, PAPEL,
};
---

<Base title="Montador de time · Aniimo Tools" description="Monte seu time de 4 Aniimo e veja a cobertura de elementos, fraquezas em comum e o equilíbrio de funções.">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-4xl">Montador de time</h1>
      <p class="mt-1 text-muted">Escolha até 4 Aniimo, ou <a href="/times/" data-umami-event="time_ir_prontos" class="font-semibold text-casal underline">comece de um time pronto</a>. O link da página guarda o time.</p>
    </div>
    <div class="flex flex-wrap gap-2">
      <button id="limpar" type="button" data-umami-event="time_limpar" class="btn" disabled>Limpar time</button>
      <button id="compartilhar" type="button" class="btn btn-primario gap-2" disabled>
        <Fragment set:html={icone('compartilhar')} /><span data-rotulo>Compartilhar time</span>
      </button>
    </div>
  </div>

  <div id="slots" class="mt-6 grid gap-3 sm:grid-cols-2">
    {[0, 1, 2, 3].map((i) => (
      <div data-slot={i} class="card flex gap-3 p-3 sm:gap-4 sm:p-4">
        <div class="relative h-16 w-16 shrink-0 sm:h-24 sm:w-24">
          <div data-vazio class="grid h-full w-full place-items-center rounded-2xl border-2 border-dashed border-danube-200 font-display text-3xl font-semibold text-danube-200">{i + 1}</div>
          <img data-img alt="" width="96" height="96" hidden class="absolute inset-0 h-full w-full rounded-2xl bg-danube-100 object-contain" />
        </div>
        <div class="min-w-0 flex-1 space-y-2.5">
          <input data-nome placeholder="Buscar Aniimo" aria-label={`Aniimo ${i + 1}`} class="w-full campo" />
          <div data-formas class="flex flex-wrap gap-1.5" aria-label={`Forma do Aniimo ${i + 1}`}></div>
          <div data-chips class="flex flex-wrap gap-1"></div>
        </div>
      </div>
    ))}
  </div>

  <section id="analise" class="mt-6 grid gap-4 md:grid-cols-3"></section>
  <p class="mt-6 text-xs text-danube-700">
    A cobertura considera o elemento de cada Aniimo como o elemento dos ataques. Para Aniimo com dois elementos, conta como fraco se <em>algum</em> dos
    elementos sofrer 1,6×. A tabela de tipos é da comunidade; veja em <a class="underline" href="/tipos/">Tipos</a>.
  </p>

  <section class="mt-8 rounded-[20px] bg-casal-50 p-4 sm:p-5" aria-labelledby="titulo-sugestao">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="max-w-2xl">
        <h2 id="titulo-sugestao" class="flex items-center gap-2 text-lg font-semibold">
          <Fragment set:html={icone('brilho', 'h-5 w-5 text-casal')} />Completar o time
        </h2>
        <p class="mt-0.5 text-sm text-muted">Escolha pelo menos 1 Aniimo e a gente sugere o resto, mantendo quem você já escolheu: mais cobertura de elementos, menos fraquezas em comum e funções variadas.</p>
      </div>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <select id="formas-sugestao" aria-label="Formas nas sugestões" class="campo h-10 text-sm">
          <option value="sem-prismana">Sem Prismana</option>
          <option value="basicas">Só formas básicas</option>
          <option value="todas">Todas (com Prismana)</option>
        </select>
        <label id="rotulo-colecao" hidden class="flex cursor-pointer items-center gap-2 text-sm font-semibold text-casal">
          <input id="so-colecao" type="checkbox" /> Só da <a href="/colecao/" class="underline">minha coleção</a>
        </label>
        <button id="sugerir" type="button" class="btn btn-primario gap-2">
          <Fragment set:html={icone('brilho')} /><span data-rotulo>Sugerir time</span>
        </button>
      </div>
    </div>
    <div id="sugestoes" class="mt-4 grid gap-3 empty:hidden md:grid-cols-3" aria-live="polite"></div>
  </section>

  <script type="application/json" id="dados" set:html={JSON.stringify(dados).replaceAll('<', '\\u003c')} />
</Base>

<script>
  import { evento, umaVez } from '../scripts/evento.ts';
  import { chip, esc, iconeEl, pilulas, seletor } from '../scripts/seletor.ts';
  import { icone, type Icone } from '../scripts/icones.ts';
  import { nota, sugere, type Membro } from '../scripts/sugestao.ts';
  type F = { chave: string; nome: string; elementos: string[]; papeis: string[]; imagem: string; total: number };
  type A = { slug: string; id: string; nome: string; en: string; formas: F[] };
  const D = JSON.parse(document.getElementById('dados')!.textContent!) as {
    aniimos: A[]; ataque: Record<string, { forte: string[]; fraco: string[] }>;
    ELEMENTO: Record<string, string>; PAPEL: Record<string, string>;
  };
  const opcoes = D.aniimos.map((a) => ({
    slug: a.slug, nome: a.nome, en: a.en, imagem: a.formas[0].imagem,
    elementos: [...new Set(a.formas.flatMap((f) => f.elementos))],
    grupo: a.formas[0].papeis[0], // ponytail: hoje todo Aniimo tem uma função só, igual em todas as formas
  }));
  // Lista do seletor separada por função, nesta ordem (ninguém decora a função de cada Aniimo).
  const grupos = Object.fromEntries(['dps', 'heal', 'energy', 'sup', 'break'].map((p) => [p, D.PAPEL[p]]));
  const els = Object.keys(D.ataque);
  const slots = [...document.querySelectorAll<HTMLElement>('[data-slot]')];
  const time: ({ a: A; f: F } | null)[] = [null, null, null, null];

  function preenche(i: number, a: A | undefined, chave?: string) {
    const s = slots[i];
    const img = s.querySelector<HTMLImageElement>('[data-img]')!;
    const f = a?.formas.find((x) => x.chave === chave) ?? a?.formas[0];
    time[i] = a && f ? { a, f } : null;
    img.hidden = !f;
    s.querySelector<HTMLElement>('[data-vazio]')!.hidden = !!f;
    if (f) img.src = f.imagem; else img.removeAttribute('src');
    pilulas(s.querySelector('[data-formas]')!, a?.formas ?? [], f?.chave ?? '', (c) => { preenche(i, a, c); atualiza(); });
    s.querySelector('[data-chips]')!.innerHTML = !f ? '' : f.elementos.map(chip).join('') +
      f.papeis.map((p) => `<span class="rounded-full bg-casal-50 px-2 py-px text-[11px] font-semibold text-casal">${D.PAPEL[p]}</span>`).join('');
  }

  function analisa() {
    const membros = time.filter(Boolean) as { a: A; f: F }[];
    const box = (ic: Icone, titulo: string, corpo: string) =>
      `<div class="card p-4"><h2 class="flex items-center gap-2 font-semibold">${icone(ic, 'h-5 w-5 text-danube')}${titulo}</h2>${corpo}</div>`;
    if (!membros.length) {
      document.getElementById('analise')!.innerHTML =
        '<p class="card p-6 text-center text-muted md:col-span-3">Escolha um Aniimo para ver a cobertura, as fraquezas e as funções do time.</p>';
      return;
    }

    const meus = [...new Set(membros.flatMap((m) => m.f.elementos))];
    const cobre = els.filter((d) => meus.some((a) => D.ataque[a].forte.includes(d)));
    const naoCobre = els.filter((d) => !cobre.includes(d));

    // Para cada elemento inimigo: quantos membros levam 1,6× dele.
    const fraquezas = els
      .map((e) => ({ e, n: membros.filter((m) => m.f.elementos.some((x) => D.ataque[e].forte.includes(x))).length }))
      .filter((x) => x.n >= 2)
      .sort((x, y) => y.n - x.n);

    const papeis = membros.flatMap((m) => m.f.papeis);
    const faltam = Object.keys(D.PAPEL).filter((p) => !papeis.includes(p));

    document.getElementById('analise')!.innerHTML = [
      box('alvo', 'Cobertura ofensiva',
        `<p class="mt-1 text-sm text-muted">Causa 1,6× em <strong class="font-mono text-ink">${cobre.length}</strong> de 9 elementos.</p>
         <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-line"><div class="bg-twining h-full rounded-full" style="width:${(cobre.length / 9) * 100}%"></div></div>
         <ul class="mt-3 grid grid-cols-9 gap-1">${els.map((e) => `<li class="flex justify-center">${iconeEl(e, 30, !cobre.includes(e))}</li>`).join('')}</ul>
         ${naoCobre.length ? `<p class="mt-3 text-sm text-muted">Sem vantagem contra ${naoCobre.map((e) => D.ELEMENTO[e]).join(', ')}.</p>` : '<p class="mt-3 text-sm font-semibold text-ok">Vantagem contra todos os elementos.</p>'}`),
      box('alerta', 'Fraquezas em comum',
        fraquezas.length
          ? `<ul class="mt-2 space-y-1.5 text-sm">${fraquezas.map((x) => `<li>${chip(x.e)} bate forte em <strong>${x.n}</strong> do time</li>`).join('')}</ul>`
          : '<p class="mt-1 text-sm font-semibold text-ok">Nenhum elemento bate forte em 2 ou mais do time.</p>'),
      box('grupo', 'Funções',
        `<ul class="mt-3 grid grid-cols-5 gap-1.5">${Object.keys(D.PAPEL).map((p) => {
          const n = papeis.filter((x) => x === p).length;
          return `<li title="${D.PAPEL[p]}: ${n}" class="flex flex-col items-center gap-1 rounded-xl px-1 py-2 text-center ${n
            ? 'bg-casal-50 text-casal'
            : 'border border-dashed border-danube-200 text-muted/70'}">
            ${icone(p as Icone, 'h-5 w-5')}
            <span class="text-[10px] font-semibold leading-tight uppercase">${D.PAPEL[p]}</span>
            <span class="font-mono text-sm font-semibold">${n ? `×${n}` : '—'}</span>
          </li>`;
        }).join('')}</ul>
         ${faltam.length ? `<p class="mt-3 text-sm text-muted">Sem ${faltam.map((p) => D.PAPEL[p]).join(', ').replace(/\.$/, '')}.</p>` : '<p class="mt-3 text-sm font-semibold text-ok">Todas as funções cobertas.</p>'}`),
    ].join('');
  }

  const botao = document.getElementById('compartilhar') as HTMLButtonElement;
  const sugerir = document.getElementById('sugerir') as HTMLButtonElement;
  const limpar = document.getElementById('limpar') as HTMLButtonElement;
  const porSlug = new Map(D.aniimos.map((a) => [a.slug, a]));
  const membro = (a: A, f: F): Membro => ({ slug: a.slug, chave: f.chave, elementos: f.elementos, papeis: f.papeis, total: f.total });
  const todas = D.aniimos.flatMap((a) => a.formas.map((f) => membro(a, f)));
  // Mesma chave e formato de /colecao/ ("id/forma"); sem coleção salva, o filtro nem aparece.
  const colecao = (() => { try { return new Set<string>(JSON.parse(localStorage.getItem('aniimo-colecao-v1') ?? '[]')); } catch { return new Set<string>(); } })();
  const soColecao = document.getElementById('so-colecao') as HTMLInputElement;
  document.getElementById('rotulo-colecao')!.hidden = colecao.size === 0;
  soColecao.checked = colecao.size > 0;
  const formasSugestao = document.getElementById('formas-sugestao') as HTMLSelectElement;
  // Prismana costuma ter elementos melhores e dominaria o topo: fora por padrão.
  const tipoForma = (m: Membro) => {
    const a = porSlug.get(m.slug)!;
    return m.chave === 'prismana-form' ? 'prismana' : a.formas[0].chave === m.chave ? 'basica' : 'regional';
  };
  [soColecao, formasSugestao].forEach((el) => el.addEventListener('change', () => { document.getElementById('sugestoes')!.innerHTML = ''; }));
  formasSugestao.addEventListener('change', () => evento('time_sugestao_formas', { formas: formasSugestao.value }));
  soColecao.addEventListener('change', () => evento('time_sugestao_colecao', { ligado: soColecao.checked }));
  const rotulo = botao.querySelector('[data-rotulo]')!;
  function atualiza() {
    analisa();
    const t = time.map((m) => (m ? `${m.a.slug}:${m.f.chave}` : '')).join(',');
    history.replaceState(null, '', time.some(Boolean) ? `?t=${t}` : location.pathname + location.hash);
    botao.disabled = !time.some(Boolean);
    const vagas = time.filter((m) => !m).length;
    // Sugestão só a partir de 1 Aniimo escolhido: parte do que o jogador já usa, fica mais certeira.
    sugerir.disabled = vagas === 0 || vagas === 4;
    limpar.disabled = vagas === 4;
    sugerir.querySelector('[data-rotulo]')!.textContent = vagas === 0 ? 'Time completo' : vagas === 4 ? 'Escolha 1 Aniimo primeiro' : `Sugerir ${vagas === 1 ? '1 vaga' : `${vagas} vagas`}`;
    document.getElementById('sugestoes')!.innerHTML = '';
  }

  // Celular: folha de compartilhamento nativa. Desktop (ou se falhar): copia o link.
  botao.addEventListener('click', async () => {
    const nomes = time.filter(Boolean).map((m) => m!.a.nome).join(', ');
    const dados = { title: 'Meu time de Aniimo', text: `Meu time: ${nomes}`, url: location.href };
    if (navigator.share && matchMedia('(pointer: coarse)').matches) {
      try { await navigator.share(dados); evento('time_compartilhado', { como: 'nativo' }); return; } catch (e) { if ((e as Error).name === 'AbortError') return; }
    }
    await navigator.clipboard.writeText(location.href);
    evento('time_compartilhado', { como: 'link' });
    rotulo.textContent = 'Link copiado';
    setTimeout(() => (rotulo.textContent = 'Compartilhar time'), 1800);
  });

  const campos = slots.map((s, i) =>
    seletor(s.querySelector<HTMLInputElement>('[data-nome]')!, opcoes, (slug) => {
      preenche(i, D.aniimos.find((a) => a.slug === slug));
      atualiza();
    }, grupos));

  // Restaura o time do link (?t=slug:forma,slug:forma,...).
  (new URLSearchParams(location.search).get('t') ?? '').split(',').slice(0, 4).forEach((p, i) => {
    const [slug, chave] = p.split(':');
    const a = D.aniimos.find((x) => x.slug === slug);
    if (!a) return;
    campos[i].define(slug);
    preenche(i, a, chave);
  });
  atualiza();

  limpar.addEventListener('click', () => {
    campos.forEach((c, i) => { c.define(''); preenche(i, undefined); });
    atualiza();
  });

  sugerir.addEventListener('click', () => {
    const base = (time.filter(Boolean) as { a: A; f: F }[]).map((m) => membro(m.a, m.f));
    const livres = time.map((m, i) => (m ? -1 : i)).filter((i) => i >= 0);
    const modo = formasSugestao.value;
    const candidatas = todas.filter((m) =>
      (!soColecao.checked || colecao.has(`${porSlug.get(m.slug)!.id}/${m.chave}`))
      && (modo === 'todas' || (modo === 'basicas' ? tipoForma(m) === 'basica' : tipoForma(m) !== 'prismana')));
    const opcoes = sugere(base, candidatas, livres.length, D.ataque, 40, 6);
    evento('time_sugerir', { vagas: livres.length, formas: modo, so_colecao: soColecao.checked, opcoes: opcoes.length });
    const box = document.getElementById('sugestoes')!;
    box.innerHTML = opcoes.map((add, k) => {
      const n = nota([...base, ...add], D.ataque);
      const linhas = add.map((m) => {
        const a = porSlug.get(m.slug)!;
        const f = a.formas.find((x) => x.chave === m.chave)!;
        return `<li class="flex items-center gap-2.5">
          <img src="${esc(f.imagem)}" alt="" width="40" height="40" loading="lazy" class="h-10 w-10 shrink-0 rounded-xl bg-danube-100 object-contain" onerror="this.style.visibility='hidden'" />
          <span class="min-w-0 flex-1 leading-tight">
            <span class="block truncate font-display font-semibold">${esc(a.nome)}</span>
            <span class="block truncate text-xs text-muted">${esc(f.nome)}</span>
          </span>
          <span class="flex shrink-0 gap-1">${f.elementos.map(chip).join('')}</span>
        </li>`;
      }).join('');
      const selo = (ic: Icone, txt: string, bom: boolean) =>
        `<span class="flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-semibold ${bom ? 'bg-casal-50 text-casal' : 'bg-[#FBEDEF] text-[#8A2F3E]'}">${icone(ic, 'h-3.5 w-3.5')}${txt}</span>`;
      return `<div class="card flex flex-col gap-3 p-4">
        <span class="rotulo text-xs">Opção ${k + 1}</span>
        <ul class="space-y-2">${linhas}</ul>
        <div class="flex flex-wrap gap-1.5">
          ${selo('alvo', `${n.cobre}/9 cobertura`, n.cobre >= 8)}
          ${selo('alerta', n.risco ? `${n.risco} fraqueza${n.risco > 1 ? 's' : ''} em comum` : 'sem fraqueza em comum', n.risco === 0)}
          ${selo('grupo', `${n.papeis}/5 funções`, n.papeis >= 4)}
        </div>
        <button type="button" data-usar="${k}" class="btn mt-auto w-full justify-center">Usar esta</button>
      </div>`;
    }).join('') || `<p class="text-sm text-muted md:col-span-3">${soColecao.checked
      ? 'Sua coleção não tem Aniimo suficientes com esse filtro de formas. Mude o filtro ou desmarque "Só da minha coleção".'
      : 'Não achei nenhuma combinação para as vagas livres.'}</p>`;
    box.onclick = (ev) => {
      const b = (ev.target as HTMLElement).closest<HTMLElement>('[data-usar]');
      if (!b) return;
      evento('time_sugestao_usada', { opcao: Number(b.dataset.usar) + 1 });
      opcoes[Number(b.dataset.usar)].forEach((m, j) => {
        campos[livres[j]].define(m.slug);
        preenche(livres[j], porSlug.get(m.slug), m.chave);
      });
      atualiza();
    };
  });
</script>
