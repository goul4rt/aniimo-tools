---
import Base from '../layouts/Base.astro';
import { aniimos } from '../data.ts';
import tabela from '../../data/elementos.json';
import { COR, ELEMENTO, PAPEL } from '../rotulos.ts';

// Só o que o montador usa, embutido na página: o cálculo roda no navegador.
const dados = {
  aniimos: aniimos.map((a) => ({
    slug: a.slug, nome: a.nome.pt, en: a.nome.en,
    formas: a.formas.map((f) => ({ chave: f.chave, nome: f.nome.pt, elementos: f.elementos, papeis: f.papeis, imagem: f.imagem })),
  })),
  ataque: tabela.ataque, ELEMENTO, PAPEL, COR,
};
---

<Base title="Montador de time · Aniimo Tools" description="Monte seu time de 4 Aniimo e veja a cobertura de elementos, fraquezas em comum e o equilíbrio de funções.">
  <h1 class="text-3xl font-bold">Montador de time</h1>
  <p class="mt-1 text-slate-400">Escolha até 4 Aniimo. O link da página guarda o time, então dá para compartilhar.</p>

  <datalist id="nomes">
    {aniimos.map((a) => <option value={a.nome.pt}>{a.nome.en}</option>)}
  </datalist>

  <div id="slots" class="mt-6 grid gap-3 sm:grid-cols-2">
    {[0, 1, 2, 3].map((i) => (
      <div data-slot={i} class="flex gap-3 rounded-lg bg-slate-900 p-3 ring-1 ring-slate-800">
        <img data-img alt="" width="64" height="64" class="h-16 w-16 shrink-0 rounded bg-slate-800 object-contain" />
        <div class="min-w-0 flex-1 space-y-2">
          <input data-nome list="nomes" placeholder={`Aniimo ${i + 1}`} autocomplete="off" aria-label={`Aniimo ${i + 1}`}
            class="w-full rounded bg-slate-950 px-2 py-1.5 ring-1 ring-slate-700" />
          <select data-forma aria-label={`Forma do Aniimo ${i + 1}`} class="w-full rounded bg-slate-950 px-2 py-1.5 ring-1 ring-slate-700" disabled></select>
          <div data-chips class="flex flex-wrap gap-1"></div>
        </div>
      </div>
    ))}
  </div>

  <section id="analise" class="mt-8 grid gap-4 md:grid-cols-3"></section>
  <p class="mt-6 text-xs text-slate-500">
    A cobertura considera o elemento de cada Aniimo como o elemento dos ataques. Para Aniimo com dois elementos, conta como fraco se <em>algum</em> dos
    elementos sofrer 1,6×. A tabela de tipos é da comunidade e tem divergências; veja em <a class="underline" href="/tipos/">Tipos</a>.
  </p>

  <script type="application/json" id="dados" set:html={JSON.stringify(dados).replaceAll('<', '\\u003c')} />
</Base>

<script>
  type F = { chave: string; nome: string; elementos: string[]; papeis: string[]; imagem: string };
  type A = { slug: string; nome: string; en: string; formas: F[] };
  const D = JSON.parse(document.getElementById('dados')!.textContent!) as {
    aniimos: A[]; ataque: Record<string, { forte: string[]; fraco: string[] }>;
    ELEMENTO: Record<string, string>; PAPEL: Record<string, string>; COR: Record<string, string>;
  };
  // Nomes vêm da wiki (fonte externa): escapar antes de ir para innerHTML.
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
  const semAcento = (s: string) => s.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase().trim();
  const acha = (txt: string) => D.aniimos.find((a) => [a.nome, a.en, a.slug].some((n) => semAcento(n) === semAcento(txt)));
  const chip = (e: string) => `<span class="rounded px-1.5 py-0.5 text-xs font-medium ${D.COR[e]}">${D.ELEMENTO[e]}</span>`;
  const els = Object.keys(D.ataque);
  const slots = [...document.querySelectorAll<HTMLElement>('[data-slot]')];
  const time: ({ a: A; f: F } | null)[] = [null, null, null, null];

  function preenche(i: number, a: A | undefined, chave?: string) {
    const s = slots[i];
    const sel = s.querySelector<HTMLSelectElement>('[data-forma]')!;
    const img = s.querySelector<HTMLImageElement>('[data-img]')!;
    if (!a) {
      time[i] = null; sel.innerHTML = ''; sel.disabled = true; img.removeAttribute('src');
      s.querySelector('[data-chips]')!.innerHTML = '';
      return;
    }
    sel.innerHTML = a.formas.map((f) => `<option value="${esc(f.chave)}">${esc(f.nome)}</option>`).join('');
    sel.disabled = a.formas.length < 2;
    sel.value = a.formas.some((f) => f.chave === chave) ? chave! : a.formas[0].chave;
    const f = a.formas.find((x) => x.chave === sel.value)!;
    time[i] = { a, f };
    img.src = f.imagem;
    s.querySelector('[data-chips]')!.innerHTML = f.elementos.map(chip).join('') +
      f.papeis.map((p) => `<span class="rounded bg-slate-700 px-1.5 py-0.5 text-xs">${D.PAPEL[p]}</span>`).join('');
  }

  function analisa() {
    const membros = time.filter(Boolean) as { a: A; f: F }[];
    const box = (titulo: string, corpo: string) =>
      `<div class="rounded-lg bg-slate-900 p-4 ring-1 ring-slate-800"><h2 class="font-semibold">${titulo}</h2>${corpo}</div>`;
    if (!membros.length) { document.getElementById('analise')!.innerHTML = ''; return; }

    const meus = [...new Set(membros.flatMap((m) => m.f.elementos))];
    const cobre = els.filter((d) => meus.some((a) => D.ataque[a].forte.includes(d)));
    const naoCobre = els.filter((d) => !cobre.includes(d));

    // Para cada elemento inimigo: quantos membros levam 1,6× dele.
    const fraquezas = els
      .map((e) => ({ e, n: membros.filter((m) => m.f.elementos.some((x) => D.ataque[e].forte.includes(x))).length }))
      .filter((x) => x.n >= 2)
      .sort((x, y) => y.n - x.n);

    const papeis = membros.flatMap((m) => m.f.papeis);
    const faltam = Object.keys(D.PAPEL).filter((p) => !papeis.includes(p));
    const conta = Object.keys(D.PAPEL).filter((p) => papeis.includes(p))
      .map((p) => `${D.PAPEL[p]} ×${papeis.filter((x) => x === p).length}`).join(', ');

    document.getElementById('analise')!.innerHTML = [
      box('Cobertura ofensiva',
        `<p class="mt-1 text-sm text-slate-400">Causa 1,6× em ${cobre.length} de 9 elementos.</p>
         <div class="mt-2 flex flex-wrap gap-1">${cobre.map(chip).join('')}</div>
         ${naoCobre.length ? `<p class="mt-3 text-sm text-slate-400">Sem vantagem contra:</p><div class="mt-1 flex flex-wrap gap-1">${naoCobre.map(chip).join('')}</div>` : ''}`),
      box('Fraquezas em comum',
        fraquezas.length
          ? `<ul class="mt-2 space-y-1 text-sm">${fraquezas.map((x) => `<li>${chip(x.e)} bate forte em <strong>${x.n}</strong> do time</li>`).join('')}</ul>`
          : '<p class="mt-1 text-sm text-green-400">Nenhum elemento bate forte em 2 ou mais do time.</p>'),
      box('Funções',
        `<p class="mt-1 text-sm">${conta}</p>
         ${faltam.length ? `<p class="mt-2 text-sm text-slate-400">Sem: ${faltam.map((p) => D.PAPEL[p]).join(', ')}</p>` : ''}`),
    ].join('');
  }

  function salvaUrl() {
    const t = time.map((m) => (m ? `${m.a.slug}:${m.f.chave}` : '')).join(',');
    history.replaceState(null, '', time.some(Boolean) ? `?t=${t}` : location.pathname);
  }

  slots.forEach((s, i) => {
    const nome = s.querySelector<HTMLInputElement>('[data-nome]')!;
    nome.addEventListener('input', () => { const a = acha(nome.value); if (a || !nome.value) { preenche(i, a); analisa(); salvaUrl(); } });
    s.querySelector('[data-forma]')!.addEventListener('change', (ev) => {
      preenche(i, time[i]?.a, (ev.target as HTMLSelectElement).value); analisa(); salvaUrl();
    });
  });

  // Restaura o time do link (?t=slug:forma,slug:forma,...).
  (new URLSearchParams(location.search).get('t') ?? '').split(',').slice(0, 4).forEach((p, i) => {
    const [slug, chave] = p.split(':');
    const a = D.aniimos.find((x) => x.slug === slug);
    if (!a) return;
    slots[i].querySelector<HTMLInputElement>('[data-nome]')!.value = a.nome;
    preenche(i, a, chave);
  });
  analisa();
</script>
