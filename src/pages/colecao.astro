---
import Base from '../layouts/Base.astro';
import { aniimos, base } from '../data.ts';

const semAcento = (s: string) => s.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase();
const total = aniimos.reduce((n, a) => n + a.formas.length, 0);
---

<Base title="Coleção · Aniimo Tools" description="Rastreador de coleção de Aniimo: marque os Aniimo e formas que você já tem, incluindo Prismana. Salvo no seu navegador.">
  <h1 class="text-4xl">Minha coleção</h1>
  <p class="mt-1 text-muted">Marque as formas que você já tem. Fica salvo neste navegador; use exportar para levar para outro aparelho.</p>

  <div class="sticky top-0 z-10 -mx-4 mt-4 bg-zumthor/95 px-4 py-3 backdrop-blur">
    <p class="text-sm"><strong id="progresso">0</strong> de {total} formas · <span id="especies">0</span> de {aniimos.length} Aniimo</p>
    <div class="mt-2 h-2 overflow-hidden rounded-full bg-line"><div id="barra" class="h-2 rounded-full bg-twining" style="width:0%"></div></div>
    <div class="mt-3 flex flex-wrap gap-2 text-sm">
      <input id="busca" type="search" placeholder="Buscar…" class="min-w-0 flex-1 campo" />
      <label class="flex items-center gap-1.5"><input id="faltando" type="checkbox" /> Só o que falta</label>
      <button id="exportar" type="button" class="btn">Exportar</button>
      <label class="cursor-pointer btn">Importar<input id="importar" type="file" accept="application/json" class="hidden" /></label>
    </div>
    <p id="aviso" class="mt-2 hidden text-sm text-warn font-semibold" role="status"></p>
  </div>

  <ul id="lista" class="mt-4 space-y-2">
    {aniimos.map((a) => (
      <li data-busca={semAcento(`${a.id} ${a.nome.pt} ${a.nome.en}`)} class="card flex gap-3 p-3">
        <img src={base(a).imagem} alt="" width="48" height="48" loading="lazy" decoding="async" class="h-12 w-12 shrink-0 rounded-2xl bg-danube-100 object-contain" onerror="this.style.visibility='hidden'" />
        <div class="min-w-0">
          <a href={`/aniilog/${a.slug}/`} class="font-semibold hover:underline">{a.nome.pt}</a>
          <span class="text-xs text-danube-700">#{a.id}</span>
          <div class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-sm">
            {a.formas.map((f) => (
              <label class="flex items-center gap-1.5 text-ink">
                <input type="checkbox" value={`${a.id}/${f.chave}`} />
                {f.nome.pt}
              </label>
            ))}
          </div>
        </div>
      </li>
    ))}
  </ul>
</Base>

<script>
  const CHAVE = 'aniimo-colecao-v1';
  const caixas = [...document.querySelectorAll<HTMLInputElement>('#lista input[type=checkbox]')];
  const itens = [...document.querySelectorAll<HTMLLIElement>('#lista > li')];
  const $ = (id: string) => document.getElementById(id)!;
  const aviso = (msg: string) => { $('aviso').textContent = msg; $('aviso').classList.toggle('hidden', !msg); };

  // localStorage pode falhar (aba anônima, cookies bloqueados): a página segue funcionando, só não salva.
  function carrega(): Set<string> {
    try { return new Set(JSON.parse(localStorage.getItem(CHAVE) ?? '[]')); } catch { return new Set(); }
  }
  function salva() {
    const tem = caixas.filter((c) => c.checked).map((c) => c.value);
    try { localStorage.setItem(CHAVE, JSON.stringify(tem)); } catch { aviso('Não foi possível salvar neste navegador. Use Exportar para não perder.'); }
  }
  function atualiza() {
    const marcadas = caixas.filter((c) => c.checked).length;
    $('progresso').textContent = String(marcadas);
    $('barra').style.width = `${(marcadas / caixas.length) * 100}%`;
    $('especies').textContent = String(itens.filter((li) => li.querySelector('input:checked')).length);
    filtra();
  }
  function filtra() {
    const q = ($('busca') as HTMLInputElement).value.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase().trim();
    const faltando = ($('faltando') as HTMLInputElement).checked;
    for (const li of itens) {
      const completo = [...li.querySelectorAll<HTMLInputElement>('input')].every((c) => c.checked);
      li.hidden = (q !== '' && !li.dataset.busca!.includes(q)) || (faltando && completo);
    }
  }
  function aplica(tem: Set<string>) {
    caixas.forEach((c) => (c.checked = tem.has(c.value)));
    atualiza();
  }

  aplica(carrega());
  $('lista').addEventListener('change', () => { salva(); atualiza(); });
  $('busca').addEventListener('input', filtra);
  $('faltando').addEventListener('change', filtra);

  $('exportar').addEventListener('click', () => {
    const dados = { versao: 1, exportadoEm: new Date().toISOString(), formas: caixas.filter((c) => c.checked).map((c) => c.value) };
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([JSON.stringify(dados, null, 2)], { type: 'application/json' }));
    a.download = 'colecao-aniimo.json';
    a.click();
    URL.revokeObjectURL(a.href);
  });

  $('importar').addEventListener('change', async (ev) => {
    const input = ev.target as HTMLInputElement;
    const arquivo = input.files?.[0];
    input.value = '';
    if (!arquivo) return;
    try {
      const dados = JSON.parse(await arquivo.text());
      if (!Array.isArray(dados.formas) || !dados.formas.every((x: unknown) => typeof x === 'string')) throw new Error();
      const validas = new Set(caixas.map((c) => c.value));
      const tem = new Set<string>(dados.formas.filter((x: string) => validas.has(x)));
      aplica(tem);
      salva();
      aviso(`${tem.size} formas importadas.`);
    } catch {
      aviso('Arquivo inválido: use um arquivo gerado pelo botão Exportar.');
    }
  });
</script>
