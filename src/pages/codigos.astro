---
import Base from '../layouts/Base.astro';
import dados from '../../data/codigos.json';

const codigos = dados.codigos as { codigo: string; ativo: boolean; recompensas?: string }[];
const ativos = codigos.filter((c) => c.ativo);
const expirados = codigos.filter((c) => !c.ativo);
const data = new Date(dados.conferidoEm + 'T12:00').toLocaleDateString('pt-BR');
---

<Base title="Códigos de resgate · Aniimo Tools" description={`${ativos.length} códigos de resgate de Aniimo ativos, conferidos em ${data}. Toque para copiar.`}>
  <h1 class="text-3xl font-bold">Códigos de resgate</h1>
  <p class="mt-1 text-slate-400">{ativos.length} ativos, conferidos em {data}. Toque no código para copiar.</p>
  <p class="mt-3 text-sm text-slate-300">
    No jogo: <strong>Configurações → Conta → Resgatar código</strong>. Os códigos diferenciam maiúsculas de minúsculas.
  </p>

  <ul class="mt-6 grid gap-2 sm:grid-cols-2">
    {ativos.map((c) => (
      <li class="rounded-lg bg-slate-900 p-3 ring-1 ring-slate-800">
        <button type="button" data-copiar={c.codigo} class="w-full text-left">
          <span class="font-mono text-lg">{c.codigo}</span>
          <span data-ok class="ml-2 text-xs text-green-400" hidden>copiado</span>
        </button>
        <p class="text-sm text-slate-400">{c.recompensas ?? 'Recompensa varia entre fontes'}</p>
      </li>
    ))}
  </ul>

  <h2 class="mt-8 text-lg font-semibold text-slate-400">Expirados</h2>
  <ul class="mt-2 space-y-1 text-sm text-slate-500">
    {expirados.map((c) => <li><span class="font-mono line-through">{c.codigo}</span>{c.recompensas && ` · ${c.recompensas}`}</li>)}
  </ul>

  <p class="mt-8 text-xs text-slate-500">
    Conferido em {dados.fontes.map((f, i) => <>{i > 0 && ' e '}<a class="underline" href={f}>{new URL(f).hostname}</a></>)}. {dados.nota}
    Código não funcionou? <a class="underline" href="https://github.com/goul4rt/aniimo-tools/issues/new">Avise</a>.
  </p>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copiar]').forEach((b) =>
    b.addEventListener('click', async () => {
      await navigator.clipboard.writeText(b.dataset.copiar!);
      const ok = b.querySelector<HTMLElement>('[data-ok]')!;
      ok.hidden = false;
      setTimeout(() => (ok.hidden = true), 1500);
    }),
  );
</script>
