---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => b.data.publicadoEm.getTime() - a.data.publicadoEm.getTime());
---

<Base title="Blog · Aniimo Tools" description="Guias e novidades de Aniimo escritos pela comunidade, em português.">
  <h1 class="text-4xl">Blog</h1>
  <p class="mt-1 text-muted">Guias e novidades escritos pela comunidade.</p>

  <ul class="mt-6 grid gap-3 sm:grid-cols-2">
    {posts.map((p) => (
      <li>
        <a href={`/blog/${p.id}/`} data-umami-event="blog_abrir" data-umami-event-post={p.id} class="card block h-full p-4">
          <p class="text-xs text-muted">{p.data.publicadoEm.toLocaleDateString('pt-BR')}</p>
          <h2 class="mt-1 text-lg font-semibold">{p.data.titulo}</h2>
          <p class="mt-1 text-sm text-muted">{p.data.resumo}</p>
          {p.data.tags.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-1">{p.data.tags.map((t) => <span class="chip">{t}</span>)}</div>
          )}
        </a>
      </li>
    ))}
  </ul>
  {posts.length === 0 && <p class="mt-6 text-muted">Nenhum post ainda.</p>}
</Base>
