---
import Base from '../../layouts/Base.astro';
import SeloCategoria from '../../components/SeloCategoria.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { CATEGORIA, leitura, relacionados } from '../../blog.ts';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((p) => ({ params: { slug: p.id }, props: { p, posts } }));
}

const { p, posts } = Astro.props as { p: CollectionEntry<'blog'>; posts: CollectionEntry<'blog'>[] };
const { Content, headings } = await render(p);
const data = p.data.publicadoEm.toLocaleDateString('pt-BR');
const tempo = leitura(p.body ?? '');
const indice = headings.filter((h) => h.depth === 2);
const outros = relacionados(posts, p);
---

<Base title={`${p.data.titulo} · Blog · Aniimo Tools`} description={p.data.resumo}>
  <article class="flex flex-col gap-7">
    <a href="/blog/" class="self-start text-sm font-semibold text-casal">← Blog</a>

    <header class="flex max-w-[780px] flex-col gap-4">
      <div class="flex flex-wrap items-center gap-2.5">
        <SeloCategoria c={p.data.categoria} class="px-3 py-1 text-xs" />
        <span class="font-mono text-xs text-muted">{data} · {tempo} de leitura</span>
      </div>
      <h1 class="text-pretty font-display text-[clamp(2.25rem,5vw,3.375rem)] leading-[1.05] font-semibold text-ink">{p.data.titulo}</h1>
      <p class="text-pretty text-lg leading-snug text-muted">{p.data.resumo}</p>
      <div class="flex items-center gap-2.5">
        <span class="grid h-9 w-9 place-items-center rounded-full bg-danube-100 text-sm font-bold text-casal">{p.data.autor[0]}</span>
        <div class="flex flex-col leading-tight">
          <span class="text-sm font-bold text-ink">{p.data.autor}</span>
          <span class="text-xs text-muted">Comunidade Aniimo Tools</span>
        </div>
      </div>
    </header>

    {p.data.capa && (
      <div class="aspect-[21/9] overflow-hidden" style="border-radius:28px">
        <img src={p.data.capa} alt="" class="h-full w-full object-cover" />
      </div>
    )}

    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_240px]">
      <div class="post max-w-[680px] min-w-0">
        <Content />
      </div>
      {indice.length > 0 && (
        <aside class="flex flex-col gap-5 lg:sticky lg:top-24 lg:self-start">
          <nav class="flex flex-col gap-1.5" aria-label="Neste post">
            <span class="rotulo text-xs">Neste post</span>
            {indice.map((h) => (
              <a href={`#${h.slug}`} class="border-l-2 border-danube-100 pl-3 text-sm text-muted hover:border-danube hover:text-casal">{h.text}</a>
            ))}
          </nav>
          <button id="copiar" type="button" data-umami-event="blog_copiar_link" class="btn">Copiar link</button>
        </aside>
      )}
    </div>

    {outros.length > 0 && (
      <div class="mt-4 flex flex-col gap-4 border-t border-danube-100 pt-8">
        <h2 class="text-2xl">Continue lendo</h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {outros.map((r) => (
            <a href={`/blog/${r.id}/`} data-umami-event="blog_relacionado" data-umami-event-post={r.id} class="card flex flex-col gap-2 p-4">
              <SeloCategoria c={r.data.categoria} class="self-start px-2.5 py-0.5 text-[11px]" />
              <strong class="font-display text-lg leading-tight font-semibold text-ink">{r.data.titulo}</strong>
              <span class="font-mono text-[11px] text-muted">{r.data.publicadoEm.toLocaleDateString('pt-BR')} · {leitura(r.body ?? '')}</span>
            </a>
          ))}
        </div>
      </div>
    )}

    <p class="text-xs text-danube-700">
      Escrito pela comunidade. Achou um erro? <a class="underline" href="https://github.com/goul4rt/aniimo-tools/issues/new">Avise</a>.
    </p>
  </article>
</Base>

<script>
  const botao = document.getElementById('copiar') as HTMLButtonElement | null;
  botao?.addEventListener('click', async () => {
    await navigator.clipboard.writeText(location.href);
    botao.textContent = 'Link copiado';
    setTimeout(() => (botao.textContent = 'Copiar link'), 1500);
  });
</script>
