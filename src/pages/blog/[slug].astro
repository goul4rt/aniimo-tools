---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((p) => ({ params: { slug: p.id }, props: { p } }));
}

const { p } = Astro.props as { p: CollectionEntry<'blog'> };
const { Content } = await render(p);
const data = p.data.publicadoEm.toLocaleDateString('pt-BR');
---

<Base title={`${p.data.titulo} · Blog · Aniimo Tools`} description={p.data.resumo}>
  <a href="/blog/" class="text-sm text-muted hover:text-danube">← Blog</a>

  <header class="mt-4">
    <p class="text-xs text-muted">{data}</p>
    <h1 class="text-4xl">{p.data.titulo}</h1>
    {p.data.tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-1">{p.data.tags.map((t) => <span class="chip">{t}</span>)}</div>
    )}
  </header>

  <div class="post mt-6 max-w-2xl">
    <Content />
  </div>

  <p class="mt-8 text-xs text-danube-700">
    Escrito pela comunidade. Achou um erro? <a class="underline" href="https://github.com/goul4rt/aniimo-tools/issues/new">Avise</a>.
  </p>
</Base>
