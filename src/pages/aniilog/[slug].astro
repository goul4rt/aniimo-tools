---
import Base from '../../layouts/Base.astro';
import Elemento from '../../components/Elemento.astro';
import Hab from '../../components/Hab.astro';
import { aniimos, porSlug } from '../../data.ts';
import { ESTAGIO, PAPEL, STAT } from '../../rotulos.ts';
import type { Aniimo, Habilidade } from '../../types.ts';

export function getStaticPaths() {
  return aniimos.map((a) => ({ params: { slug: a.slug }, props: { a } }));
}

const { a } = Astro.props as { a: Aniimo };
// De onde este Aniimo evolui: quem o lista em evoluiPara.
const vemDe = aniimos.filter((x) => x.evoluiPara.includes(a.slug));
const evolui = a.evoluiPara.map((s) => porSlug.get(s)!).filter(Boolean);
const GRUPO: Record<string, string> = { combat: 'Combate', innate: 'Inata', mobility: 'Mobilidade' };
// ponytail: escala fixa das barras; o maior stat individual na wiki hoje fica perto de 150
const MAX_STAT = 160;
const statKeys = ['hp', 'atk', 'brk', 'pdef', 'mdef', 'regen'] as const;
const porGrupo = (hs: Habilidade[]) => Object.entries(Object.groupBy(hs, (h) => h.grupo));
const data = new Date(a.coletadoEm).toLocaleDateString('pt-BR');
// Google corta a description perto de 160 caracteres: a lore entra só até a última palavra que cabe.
const inicio = `${a.nome.pt} (${a.nome.en}), Aniimo #${a.id}: stats, skills, formas e onde encontrar.`;
const resto = 155 - inicio.length - 1;
const lore = a.desc.pt.length <= resto ? a.desc.pt : `${a.desc.pt.slice(0, resto - 1).replace(/\s+\S*$/, '')}…`;
const descricao = resto > 20 ? `${inicio} ${lore}` : inicio;
---

<Base
  title={`${a.nome.pt} (${a.nome.en}) · Aniilog`}
  description={descricao}
>
  <a href="/aniilog/" data-umami-event="aniimo_voltar" class="text-sm text-muted hover:text-danube">← Aniilog</a>

  <header class="mt-4">
    <p class="font-mono text-sm font-semibold text-danube">#{a.id}</p>
    <h1 class="text-4xl">{a.nome.pt}</h1>
    <p class="text-muted">{a.nome.en}</p>
    <p class="mt-3 max-w-2xl text-ink">{a.desc.pt}</p>
    {(vemDe.length > 0 || evolui.length > 0) && (
      <p class="mt-3 text-sm text-muted">
        {vemDe.length > 0 && <>Evolui de {vemDe.map((x, i) => <>{i > 0 && ', '}<a class="underline hover:text-danube" data-umami-event="aniimo_evolucao" data-umami-event-para={x.slug} href={`/aniilog/${x.slug}/`}>{x.nome.pt}</a></>)}. </>}
        {evolui.length > 0 && <>Evolui para {evolui.map((x, i) => <>{i > 0 && ', '}<a class="underline hover:text-danube" data-umami-event="aniimo_evolucao" data-umami-event-para={x.slug} href={`/aniilog/${x.slug}/`}>{x.nome.pt}</a></>)}.</>}
      </p>
    )}
  </header>

  {a.formas.length > 1 && (
    <nav class="mt-6 flex flex-wrap gap-2 text-sm" aria-label="Formas">
      {a.formas.map((f) => <a href={`#${f.chave}`} data-umami-event="aniimo_forma" data-umami-event-forma={f.chave} class="chip">{f.nome.pt}</a>)}
    </nav>
  )}

  {a.formas.map((f) => (
    <section id={f.chave} class="mt-8 scroll-mt-4 card p-4">
      <div class="grid gap-6 md:grid-cols-[16rem_1fr]">
        <div class="aspect-square overflow-hidden rounded-2xl bg-danube-100">
          <img src={f.imagem} alt={`${a.nome.pt}, ${f.nome.pt}`} loading="lazy" decoding="async" class="h-full w-full object-contain" onerror="this.remove()" />
        </div>
        <div>
          <h2 class="text-2xl font-semibold">{f.nome.pt}</h2>
          <p class="text-sm text-muted">{ESTAGIO[f.estagio] ?? `Estágio ${f.estagio}`} · {f.papeis.map((p) => PAPEL[p]).join(', ')}</p>
          <div class="mt-2 flex flex-wrap gap-1">{f.elementos.map((e) => <Elemento e={e} />)}</div>

          <table class="mt-4 w-full max-w-md text-sm">
            <tbody>
              {statKeys.map((k) => (
                <tr>
                  <th class="w-16 py-0.5 text-left font-normal text-muted">{STAT[k]}</th>
                  <td class="w-10 text-right font-mono font-semibold tabular-nums">{f.stats[k]}</td>
                  <td class="pl-3"><div class="h-2 rounded-full bg-danube" style={`width:${Math.min(100, (f.stats[k] / MAX_STAT) * 100)}%`}></div></td>
                </tr>
              ))}
              <tr><th class="py-0.5 text-left font-normal text-muted">{STAT.total}</th><td class="text-right font-semibold tabular-nums">{f.stats.total}</td><td></td></tr>
            </tbody>
          </table>

          {f.locais.length > 0 && (
            <p class="mt-4 text-sm"><span class="text-muted">Onde encontrar:</span> {f.locais.map((l) => l.pt).join(', ')}</p>
          )}
        </div>
      </div>

      {f.traits.length > 0 && (
        <>
          <h3 class="rotulo mt-6">Traços</h3>
          <ul class="mt-2 space-y-3">{f.traits.map((h) => <Hab h={h} />)}</ul>
        </>
      )}
      {porGrupo(f.skills).map(([g, hs]) => (
        <>
          <h3 class="rotulo mt-6">Skills · {GRUPO[g] ?? g}</h3>
          <ul class="mt-2 space-y-3">{hs!.map((h) => <Hab h={h} />)}</ul>
        </>
      ))}
    </section>
  ))}

  <p class="mt-8 text-xs text-danube-700">
    Dados da <a class="underline" href={`https://wiki.aniimo.com/pt/item/${a.id}/${a.formas[0].chave}`}>wiki oficial</a>, atualizados em {data}.
    Achou um erro? <a class="underline" href="https://github.com/goul4rt/aniimo-tools/issues/new">Avise</a>.
  </p>
</Base>

