---
import Base from '../layouts/Base.astro';
import { aniimos } from '../data.ts';
import { STAT } from '../rotulos.ts';
import tabela from '../../data/elementos.json';

const dados = {
  aniimos: aniimos.map((a) => ({
    slug: a.slug, nome: a.nome.pt, en: a.nome.en,
    formas: a.formas.map((f) => ({ chave: f.chave, nome: f.nome.pt, elementos: f.elementos, stats: f.stats, imagem: f.imagem })),
  })),
  STAT, ataque: tabela.ataque,
};
---

<Base title="Comparar stats · Aniimo Tools" description="Compare os stats de até 3 Aniimo ou formas lado a lado: PV, ATQ, QUEBRA, DEF F., DEF M. e REGEN.">
  <h1 class="text-4xl">Comparar stats</h1>
  <p class="mt-1 text-muted">Escolha até 3 Aniimo ou formas. O maior valor de cada stat fica destacado. O link guarda a comparação.</p>

  <div class="mt-6 grid gap-3 sm:grid-cols-3">
    {[0, 1, 2].map((i) => (
      <div data-slot={i} class="card flex flex-col gap-3 p-4">
        <div class="relative mx-auto aspect-square w-full max-w-24 sm:max-w-40">
          <div data-vazio class="grid h-full w-full place-items-center rounded-2xl border-2 border-dashed border-danube-200 font-display text-4xl font-semibold text-danube-200">{i + 1}</div>
          <img data-img alt="" hidden class="absolute inset-0 h-full w-full rounded-2xl bg-danube-100 object-contain" />
        </div>
        <input data-nome placeholder="Buscar Aniimo ou elemento" aria-label={`Aniimo ${i + 1}`} class="w-full campo" />
        <div data-formas class="flex flex-wrap gap-1.5" aria-label={`Forma do Aniimo ${i + 1}`}></div>
      </div>
    ))}
  </div>

  <div id="tabela" class="mt-6"></div>

  <script type="application/json" id="dados" set:html={JSON.stringify(dados).replaceAll('<', '\\u003c')} />
</Base>

<script>
  import { umaVez } from '../scripts/evento.ts';
  import { chip, esc, iconeEl, pilulas, seletor } from '../scripts/seletor.ts';
  type F = { chave: string; nome: string; elementos: string[]; stats: Record<string, number>; imagem: string };
  type A = { slug: string; nome: string; en: string; formas: F[] };
  const D = JSON.parse(document.getElementById('dados')!.textContent!) as { aniimos: A[]; STAT: Record<string, string>; ataque: Record<string, { forte: string[] }> };
  const els = Object.keys(D.ataque);
  const opcoes = D.aniimos.map((a) => ({
    slug: a.slug, nome: a.nome, en: a.en, imagem: a.formas[0].imagem,
    elementos: [...new Set(a.formas.flatMap((f) => f.elementos))],
  }));
  const slots = [...document.querySelectorAll<HTMLElement>('[data-slot]')];
  const sel: ({ a: A; f: F } | null)[] = [null, null, null];
  const MAX = 160; // ponytail: mesma escala fixa do Aniilog
  // Uma cor por coluna, para ligar a barra ao Aniimo do cabeçalho.
  const CORES = ['bg-danube', 'bg-casal-400', 'bg-[#F48DB8]'];

  function preenche(i: number, a: A | undefined, chave?: string) {
    const s = slots[i];
    const img = s.querySelector<HTMLImageElement>('[data-img]')!;
    const f = a?.formas.find((x) => x.chave === chave) ?? a?.formas[0];
    sel[i] = a && f ? { a, f } : null;
    img.hidden = !f;
    s.querySelector<HTMLElement>('[data-vazio]')!.hidden = !!f;
    if (f) img.src = f.imagem; else img.removeAttribute('src');
    pilulas(s.querySelector('[data-formas]')!, a?.formas ?? [], f?.chave ?? '', (c) => { preenche(i, a, c); desenha(); });
  }

  function desenha() {
    const c = sel.map((m) => (m ? `${m.a.slug}:${m.f.chave}` : '')).join(',');
    history.replaceState(null, '', sel.some(Boolean) ? `?c=${c}` : location.pathname);
    const t = document.getElementById('tabela')!;
    if (sel.filter(Boolean).length > 1) umaVez('comparar_usado');
    if (!sel.some(Boolean)) {
      t.innerHTML = '<p class="card p-6 text-center text-muted">Escolha pelo menos um Aniimo para ver os stats.</p>';
      return;
    }
    // Sempre 3 colunas de largura igual (table-fixed): a tabela não muda de forma conforme o tamanho dos nomes.
    const cab = sel.map((m, i) => !m
      ? `<th class="p-2 align-bottom font-normal sm:p-3"><span class="mb-1.5 block h-1 w-6 rounded-full bg-line"></span><span class="text-xs text-danube-200">Vazio</span></th>`
      : `<th class="p-2 text-left align-bottom font-normal sm:p-3">
        <span class="mb-1.5 block h-1 w-6 rounded-full ${CORES[i]}"></span>
        <a class="block truncate font-display text-sm font-semibold text-ink hover:text-danube sm:text-base" title="${esc(m.a.nome)}"
          href="/aniilog/${esc(m.a.slug)}/#${esc(m.f.chave)}">${esc(m.a.nome)}</a>
        <span class="block truncate text-xs text-muted" title="${esc(m.f.nome)}">${esc(m.f.nome)}</span>
        <span class="mt-1.5 hidden flex-wrap gap-1 sm:flex">${m.f.elementos.map(chip).join('')}</span>
      </th>`).join('');
    const linhas = Object.keys(D.STAT).map((k) => {
      const vals = sel.map((m) => m?.f.stats[k]);
      const top = Math.max(...vals.filter((v) => v != null) as number[]);
      const varios = vals.filter((v) => v != null).length > 1;
      const total = k === 'total';
      return `<tr class="border-t border-line ${total ? 'bg-danube-50' : ''}">
        <th class="rotulo p-2 text-left text-[11px] sm:p-3 sm:text-xs">${D.STAT[k]}</th>${vals.map((v, i) => {
        if (v == null) return '<td class="p-2 text-danube-200 sm:p-3">—</td>';
        const melhor = varios && v === top;
        const barra = total ? '' : `<div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-line"><div class="h-full rounded-full ${CORES[i]}" style="width:${Math.min(100, (v / MAX) * 100)}%"></div></div>`;
        return `<td class="p-2 sm:p-3"><span class="font-mono tabular-nums ${melhor ? 'font-semibold text-ok' : 'text-ink'}">${v}${melhor ? '<span class="ml-1 text-xs" aria-label="maior">▲</span>' : ''}</span>${barra}</td>`;
      }).join('')}</tr>`;
    }).join('');
    // Mesma regra do montador de time: forte se algum elemento dele causa 1,6×; fraco se algum elemento dele leva 1,6×.
    const tipos = (rotulo: string, lista: (f: F) => string[]) => `<tr class="border-t border-line">
      <th class="rotulo p-2 text-left text-[11px] sm:p-3 sm:text-xs">${rotulo}</th>${sel.map((m) => !m
        ? '<td class="p-2 text-danube-200 sm:p-3">—</td>'
        : `<td class="p-2 sm:p-3"><span class="flex flex-wrap gap-1">${lista(m.f).map((e) => iconeEl(e, 26)).join('') || '<span class="text-danube-200">—</span>'}</span></td>`).join('')}</tr>`;
    const linhasTipo = tipos('Bate forte em', (f) => els.filter((d) => f.elementos.some((a) => D.ataque[a].forte.includes(d))))
      + tipos('Leva 1,6× de', (f) => els.filter((a) => f.elementos.some((d) => D.ataque[a].forte.includes(d))));
    t.innerHTML = `<div class="card overflow-hidden"><table class="w-full table-fixed text-sm">
      <colgroup><col class="w-18 sm:w-28" /><col /><col /><col /></colgroup>
      <thead><tr><th></th>${cab}</tr></thead><tbody>${linhas}${linhasTipo}</tbody></table></div>`;
  }

  const campos = slots.map((s, i) =>
    seletor(s.querySelector<HTMLInputElement>('[data-nome]')!, opcoes, (slug) => {
      preenche(i, D.aniimos.find((a) => a.slug === slug));
      desenha();
    }));

  (new URLSearchParams(location.search).get('c') ?? '').split(',').slice(0, 3).forEach((p, i) => {
    const [slug, chave] = p.split(':');
    const a = D.aniimos.find((x) => x.slug === slug);
    if (!a) return;
    campos[i].define(slug);
    preenche(i, a, chave);
  });
  desenha();
</script>
